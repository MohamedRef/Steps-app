# Copy to `.env` (git-ignored) and fill in. `just` loads it, and the app reads
# these at build time (`just run`, `just android`). Nothing here is committed.
# Steps's own values: never reuse Kabar's Worker, client or secrets.

# Your deployed Worker (docs/CLOUD.md §3.3)
STEPS_CLOUD_URL=https://steps-cloud.YOUR-SUBDOMAIN.workers.dev
# Google Cloud → project "Steps" → Clients → "Steps desktop" (Desktop app).
# Used on the Mac and on Android (browser + loopback sign-in).
STEPS_GOOGLE_CLIENT_ID=1234-desktop.apps.googleusercontent.com
# The same Desktop client's secret. Google treats installed-app secrets as
# non-confidential, but it still stays out of the repo.
STEPS_GOOGLE_CLIENT_SECRET=GOCSPX-...
